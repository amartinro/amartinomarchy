#!/bin/sh
# git credential helper para GitHub a traves de gh.
#
# No usa el shim de mise (~/.local/bin/gh) porque imprime una linea de mas en
# stdout ("mise ... tools: gh@x.y.z") y eso rompe el protocolo de credenciales
# de git. Aqui se resuelve el binario real en el momento, asi que el helper
# sobrevive a las actualizaciones de gh (y a que cambie la ruta versionada).

if command -v mise >/dev/null 2>&1; then
  GH=$(mise which gh 2>/dev/null || true)
fi

if [ -z "${GH:-}" ] || [ ! -x "$GH" ]; then
  GH=$(ls -1 "$HOME"/.local/share/mise/installs/gh/*/gh_*/bin/gh 2>/dev/null | sort -V | tail -1)
fi

if [ -z "${GH:-}" ] || [ ! -x "$GH" ]; then
  GH=$(command -v gh)
fi

[ -x "$GH" ] || { echo "gh-git-credential: no encuentro gh" >&2; exit 1; }

exec "$GH" auth git-credential "$@"
